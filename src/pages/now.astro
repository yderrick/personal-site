---
import { getEntry, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import { formatLogDate, isoDate } from '../lib/log';

const entry = await getEntry('now', 'index');
if (!entry) throw new Error('src/content/now/index.md is missing');

const { Content } = await render(entry);

const updated = entry.data.updated;
const daysOld = Math.floor((Date.now() - updated.getTime()) / 86_400_000);

/**
 * A /now page exists to say "this is what is true today", so an old one is not
 * merely out of date — it is the site making a claim it can no longer support.
 * The page shows its own age to the reader, and the build says so out loud once
 * it crosses two months, which is roughly the point at which the words stop
 * matching the work.
 *
 * A warning rather than an error: a stale sentence should never be the reason a
 * deploy fails, and the daily refresh build would then break the whole site on
 * a schedule.
 */
const STALE_AFTER_DAYS = 60;
if (daysOld > STALE_AFTER_DAYS) {
	console.warn(
		`[now] src/content/now/index.md was last updated ${daysOld} days ago ` +
			`(${isoDate(updated)}). The page is telling readers it is current. ` +
			'Rewrite it, or delete the page.',
	);
}
---

<BaseLayout
	title={entry.data.title}
	description="What I'm working on at the moment — updated by hand, dated so you can tell how current it is."
>
	<header class="head">
		<h1>{entry.data.headline}</h1>
		<p class="stamp">
			Last checked <time datetime={isoDate(updated)}>{formatLogDate(updated)}</time>
			{daysOld > STALE_AFTER_DAYS && <span class="stale">— overdue a rewrite</span>}
		</p>
	</header>

	<div class="prose">
		<Content />
	</div>

	<p class="onward">
		The <a href="/log">log</a> has the day-to-day; <a href="/projects">projects</a> has the numbers.
	</p>
</BaseLayout>

<style>
	.head {
		padding-block: var(--space-8) var(--space-5);
	}

	.head h1 {
		font-size: var(--text-3xl);
		max-width: 18ch;
		margin-bottom: var(--space-4);
	}

	.stamp {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-fg-muted);
		margin: 0;
	}

	.stale {
		color: var(--color-accent);
	}

	.prose {
		max-width: var(--measure);
	}

	.prose :global(p),
	.prose :global(ul) {
		margin-block: 0 var(--space-5);
	}

	/* Matches the section headings on /about — same kind of signpost through a
	   page of prose, so it should read the same way. */
	.prose :global(h2) {
		font-family: var(--font-mono);
		font-weight: var(--weight-medium);
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-mono);
		color: var(--color-accent);
		margin-block: var(--space-7) var(--space-4);
		padding-bottom: var(--space-2);
		border-bottom: var(--border) solid var(--color-rule);
	}

	.prose :global(strong) {
		color: var(--color-fg);
		font-weight: var(--weight-semi);
	}

	.onward {
		max-width: var(--measure);
		margin-top: var(--space-8);
		padding-top: var(--space-5);
		border-top: var(--border) solid var(--color-rule);
		color: var(--color-fg-muted);
	}
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';
import { getWritingEntries, writingHref } from '../../lib/writing';
import ledger from '../../data/writing-ledger.json';

const REPO = 'https://github.com/yderrick/personal-site';

interface Revision {
	sha256: string;
	stampedAt: string;
	title: string;
	ots?: string;
	bitcoin?: boolean;
}

const entries = await getWritingEntries();

// Driven by the ledger, not the collection: a piece that has been taken down
// still has a record, and dropping it here would make the record editable by
// deletion — which is the one thing it must not be.
const rows = Object.entries(ledger as Record<string, Revision[]>)
	.map(([slug, revisions]) => ({
		slug,
		entry: entries.find((candidate) => candidate.id === slug),
		revisions: [...revisions].reverse(),
	}))
	.sort((a, b) => {
		const at = a.revisions[0]?.stampedAt ?? '';
		const bt = b.revisions[0]?.stampedAt ?? '';
		return bt.localeCompare(at);
	});

const anchored = rows.flatMap((row) => row.revisions).filter((rev) => rev.bitcoin).length;
const total = rows.flatMap((row) => row.revisions).length;
---

<BaseLayout
	title="Authorship record"
	description="A dated hash of every piece of writing on this site, and what each one does and doesn't prove."
>
	<header class="head">
		<h1>Authorship record</h1>
		<p>
			Every piece on this site is hashed when it's published, and the hash is submitted to
			OpenTimestamps. That produces a proof that a particular text existed before a particular
			Bitcoin block — checkable by anyone, without having to take my word for it or GitHub's.
		</p>
		<p>
			I don't especially mind being copied. This is here for the case where someone claims they
			wrote it first.
		</p>
	</header>

	<section class="what" aria-labelledby="what-heading">
		<h2 id="what-heading">What this actually proves</h2>
		<dl>
			<dt>The hash</dt>
			<dd>
				Identifies the text exactly — change one word and it changes completely. On its own it
				proves nothing, because I'm the one who committed it.
			</dd>

			<dt>The commit date</dt>
			<dd>
				Git records when each hash was added, and GitHub records the push server-side, where I
				can't backdate it. Good evidence, if you're willing to trust GitHub.
			</dd>

			<dt>The OpenTimestamps proof</dt>
			<dd>
				The part that stands on its own. The hash is folded into a tree whose root is written
				into the Bitcoin blockchain, so the proof shows the text existed before that block was
				mined. It needs no trust in me, in GitHub, or in this page.
			</dd>
		</dl>

		<p class="caveat">
			Copyright in all of this exists from the moment it was written, under the Berne Convention,
			regardless of anything on this page. These are records, not the source of the right — and
			none of it is legal advice.
		</p>
	</section>

	<section class="record" aria-labelledby="record-heading">
		<div class="record-head">
			<h2 id="record-heading">The record</h2>
			<p class="tally">{anchored} of {total} revisions anchored</p>
		</div>

		{
			rows.length === 0 ? (
				<p class="empty">Nothing recorded yet.</p>
			) : (
				<ul class="pieces">
					{rows.map((row) => (
						<li class="piece">
							<h3>
								{row.entry ? (
									<a href={writingHref(row.entry)}>{row.entry.data.title}</a>
								) : (
									<span class="gone">
										{row.revisions[0]?.title ?? row.slug}
										<span class="gone-note">no longer published</span>
									</span>
								)}
							</h3>

							<ol class="revisions">
								{row.revisions.map((rev, index) => (
									<li class="revision">
										<span class="rev-label">
											{index === row.revisions.length - 1 ? 'first' : `rev ${row.revisions.length - index}`}
										</span>
										<time datetime={rev.stampedAt}>{formatDate(new Date(rev.stampedAt))}</time>
										<code class="hash" title={rev.sha256}>{rev.sha256.slice(0, 16)}…</code>
										{rev.bitcoin ? (
											<a class="state anchored" href={`${REPO}/blob/main/${rev.ots}`}>
												anchored ↗
											</a>
										) : rev.ots ? (
											<a class="state pending" href={`${REPO}/blob/main/${rev.ots}`}>
												awaiting confirmation ↗
											</a>
										) : (
											<span class="state none">hash only</span>
										)}
									</li>
								))}
							</ol>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<section class="verify" aria-labelledby="verify-heading">
		<h2 id="verify-heading">Check it yourself</h2>
		<p>
			Nothing here asks to be believed. To confirm a hash matches what's published, take the body
			of the file — everything after the closing <code>---</code> of the frontmatter — normalise
			it to Unix line endings, strip trailing whitespace, and hash it:
		</p>
		<pre><code>git clone {REPO}
cd personal-site
node scripts/stamp-writing.mjs --check</code></pre>
		<p>
			That recomputes every hash from the files and exits non-zero if any of them has drifted from
			what this page claims.
		</p>
		<p>
			To verify a proof independently of this repository, install the{' '}
			<a href="https://github.com/opentimestamps/opentimestamps-client">OpenTimestamps client</a>{' '}
			and run <code>ots verify</code> against the <code>.ots</code> file linked beside a revision.
			It will report the Bitcoin block, and its time, that the text is proven to predate.
		</p>
	</section>
</BaseLayout>

<style>
	.head {
		padding-block: var(--space-8) var(--space-6);
	}

	.head h1 {
		font-size: var(--text-3xl);
		margin-bottom: var(--space-4);
	}

	.head p {
		max-width: var(--measure);
		color: var(--color-fg-muted);
		margin-bottom: var(--space-4);
	}

	section {
		padding-block: var(--space-6);
		border-top: var(--border) solid var(--color-rule);
	}

	section h2 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-4);
	}

	dl {
		max-width: var(--measure);
		margin: 0;
	}

	dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	dd {
		margin: 0 0 var(--space-5);
		color: var(--color-fg-muted);
	}

	.caveat {
		max-width: var(--measure);
		font-size: var(--text-base);
		color: var(--color-fg-muted);
		border-left: 2px solid var(--color-rule-strong);
		padding-left: var(--space-4);
	}

	.record-head {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}

	.record-head h2 {
		margin-bottom: 0;
	}

	.tally {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-fg-muted);
		margin-left: auto;
		font-variant-numeric: tabular-nums;
	}

	.pieces,
	.revisions {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.piece {
		padding-block: var(--space-4);
		border-bottom: var(--border) solid var(--color-rule);
	}

	.piece h3 {
		font-family: var(--font-body);
		font-weight: var(--weight-semi);
		font-size: var(--text-md);
		letter-spacing: var(--tracking-normal);
		margin-bottom: var(--space-3);
	}

	.piece h3 a {
		color: var(--color-fg);
		text-decoration: none;
	}

	.piece h3 a:hover {
		color: var(--color-accent);
	}

	.gone {
		color: var(--color-fg-muted);
	}

	.gone-note {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: var(--tracking-mono);
		margin-left: var(--space-3);
	}

	.revision {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
	}

	.rev-label {
		color: var(--color-fg-muted);
		min-width: 4rem;
	}

	.revision time {
		color: var(--color-fg);
		font-variant-numeric: tabular-nums;
		min-width: 8rem;
	}

	.hash {
		color: var(--color-fg-muted);
		font-size: var(--text-2xs);
		overflow-wrap: anywhere;
	}

	.state {
		margin-left: auto;
		text-decoration: none;
		font-size: var(--text-2xs);
	}

	.state.anchored {
		color: var(--color-accent);
	}

	.state.pending,
	.state.none {
		color: var(--color-fg-muted);
	}

	/* The status column sits right on a wide screen and wraps to its own line
	   on a phone rather than being squeezed against the hash. */
	@media (max-width: 40rem) {
		.state {
			margin-left: 0;
		}
	}

	.verify p {
		max-width: var(--measure);
		color: var(--color-fg-muted);
		margin-bottom: var(--space-4);
	}

	.verify pre {
		background: var(--color-surface);
		border: var(--border) solid var(--color-rule);
		border-radius: var(--radius);
		padding: var(--space-4);
		overflow-x: auto;
		margin-bottom: var(--space-4);
		font-size: var(--text-base);
	}

	.verify :not(pre) > code {
		background: var(--color-surface);
		border: var(--border) solid var(--color-rule);
		border-radius: var(--radius-sm);
		padding: 0.1em 0.35em;
	}

	.empty {
		color: var(--color-fg-muted);
	}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogList from '../components/LogList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getLogEntries, getRecentLogEntries } from '../lib/log';
import { getShowcase } from '../lib/showcase';
import { SITE } from '../consts';

const recent = await getRecentLogEntries(3);
const total = (await getLogEntries()).length;

const { items } = await getShowcase();
// Pinned projects if any are marked, otherwise just the most recently touched.
const pinned = items.filter((item) => item.pinned);
const featured = (pinned.length > 0 ? pinned : items).slice(0, 2);
---

<BaseLayout>
	<section class="hero">
		<h1>{SITE.tagline}</h1>
		<p class="intro">
			A developer working in the open. Everything I ship gets a dated entry — the fixes, the dead
			ends, and the things I only understood on the second attempt.
		</p>
	</section>

	<section class="slot" aria-labelledby="log-heading">
		<div class="slot-head">
			<h2 id="log-heading">Recent</h2>
			<a class="more" href="/log">All {total} entries</a>
		</div>

		{
			recent.length > 0 ? (
				<LogList entries={recent} headingLevel={3} />
			) : (
				<p class="slot-body">No entries yet. The first one lands the day I next build something.</p>
			)
		}
	</section>

	<section class="slot" aria-labelledby="projects-heading">
		<div class="slot-head">
			<h2 id="projects-heading">Projects</h2>
			<a class="more" href="/projects">All projects</a>
		</div>

		{
			featured.length > 0 ? (
				<div class="featured">
					{featured.map((item) => (
						<ProjectCard item={item} />
					))}
				</div>
			) : (
				<p class="slot-body">Nothing to show here yet.</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-9) var(--space-8);
	}

	.hero h1 {
		font-size: var(--text-4xl);
		max-width: 14ch;
		margin-bottom: var(--space-5);
	}

	.intro {
		max-width: var(--measure);
		color: var(--color-fg-muted);
	}

	.slot {
		border-top: var(--border) solid var(--color-rule);
		padding-block: var(--space-5) var(--space-7);
	}

	.slot-head {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
	}

	.slot-head h2 {
		font-size: var(--text-lg);
	}

	.more {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-fg-muted);
		text-decoration: none;
	}

	.more:hover {
		color: var(--color-accent);
	}

	.featured {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
	}

	@media (max-width: 44rem) {
		.featured {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Cards on the home page are previews, so they ignore their bento span and
	   sit in an even two-up. */
	.featured :global(.card) {
		grid-column: auto;
		grid-row: auto;
	}

	/* Which phase builds this. The roadmap is public, so the placeholder may as
	   well say where it sits in it. */
	.status {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-accent);
		border: var(--border) solid var(--color-accent-quiet);
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
		border-radius: var(--radius-sm);
		padding: var(--space-1) var(--space-2);
	}

	.slot-body {
		max-width: var(--measure);
		font-size: var(--text-base);
		color: var(--color-fg-muted);
	}
</style>
